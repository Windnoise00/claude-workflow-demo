{
  "autoMemoryDirectory": "~/.claude/memory-repo",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/memory-sync.sh start", "timeout": 60 }] }],
    "SessionEnd":   [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/memory-sync.sh end",   "timeout": 60 }] }]
  }
}
